<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ------------------------------
# QUIZ ZONE
# ------------------------------
RewriteRule ^quiz-zone/?$ /quiz-zone/index.html [L,QSA]
RewriteRule ^quiz-zone/sub-categories/([^/]+)/?$ /quiz-zone/sub-categories/$1/index.html [L,QSA]
RewriteRule ^quiz-zone/level/([^/]+)/?$ /quiz-zone/level/$1/index.html [L,QSA]
RewriteRule ^quiz-zone/level/([^/]+)/dashboard-play/?$ /quiz-zone/level/$1/dashboard-play/index.html [L,QSA]
RewriteRule ^quiz-zone/result/?$ /quiz-zone/result/index.html [L,QSA]
RewriteRule ^quiz-zone/review-answer/?$ /quiz-zone/review-answer/index.html [L,QSA]

# ------------------------------
# CATEGORY MODULE - UPDATED FOR NEXT.JS
# ------------------------------
RewriteRule ^category/?$ /category/index.html [L,QSA]

# Dynamic subcategory routes - Check static first, then fallback to [subcategories]
RewriteCond %{DOCUMENT_ROOT}/category/sub-categories/$1/index.html -f
RewriteRule ^category/sub-categories/([^/]+)/?$ /category/sub-categories/$1/index.html [L,QSA]
RewriteRule ^category/sub-categories/([^/]+)/?$ /category/sub-categories/\[subcategories\]/index.html [L,QSA]

RewriteCond %{DOCUMENT_ROOT}/category/sub-categories/$1/prompt/index.html -f
RewriteRule ^category/sub-categories/([^/]+)/prompt/?$ /category/sub-categories/$1/prompt/index.html [L,QSA]
RewriteRule ^category/sub-categories/([^/]+)/prompt/?$ /category/sub-categories/\[subcategories\]/prompt/index.html [L,QSA]

RewriteCond %{DOCUMENT_ROOT}/category/sub-categories/$1/promptDetails/index.html -f
RewriteRule ^category/sub-categories/([^/]+)/promptDetails/?$ /category/sub-categories/$1/promptDetails/index.html [L,QSA]
RewriteRule ^category/sub-categories/([^/]+)/promptDetails/?$ /category/sub-categories/\[subcategories\]/promptDetails/index.html [L,QSA]

# Non-dynamic category routes
RewriteRule ^category/level/([^/]+)/?$ /category/level/$1/index.html [L,QSA]
RewriteRule ^category/level/([^/]+)/dashboard-play/?$ /category/level/$1/dashboard-play/index.html [L,QSA]
RewriteRule ^category/result/?$ /category/result/index.html [L,QSA]
RewriteRule ^category/review-answer/?$ /category/review-answer/index.html [L,QSA]

# ------------------------------
# FUN AND LEARN
# ------------------------------
RewriteRule ^fun-and-learn/?$ /fun-and-learn/index.html [L,QSA]
RewriteRule ^fun-and-learn/sub-categories/([^/]+)/?$ /fun-and-learn/sub-categories/$1/index.html [L,QSA]
RewriteRule ^fun-and-learn/fun-data/([^/]+)/?$ /fun-and-learn/fun-data/$1/index.html [L,QSA]
RewriteRule ^fun-and-learn/fun-data/([^/]+)/fun-and-learn-play/?$ /fun-and-learn/fun-data/$1/fun-and-learn-play/index.html [L,QSA]
RewriteRule ^fun-and-learn/result/?$ /fun-and-learn/result/index.html [L,QSA]
RewriteRule ^fun-and-learn/review-answer/?$ /fun-and-learn/review-answer/index.html [L,QSA]

# ------------------------------
# GUESS THE WORD
# ------------------------------
RewriteRule ^guess-the-word/?$ /guess-the-word/index.html [L,QSA]
RewriteRule ^guess-the-word/guess-the-word-play/?$ /guess-the-word/guess-the-word-play/index.html [L,QSA]
RewriteRule ^guess-the-word/subcategories/([^/]+)/?$ /guess-the-word/subcategories/$1/index.html [L,QSA]
RewriteRule ^guess-the-word/result/?$ /guess-the-word/result/index.html [L,QSA]
RewriteRule ^guess-the-word/review-answer/?$ /guess-the-word/review-answer/index.html [L,QSA]

# ------------------------------
# SELF LEARNING
# ------------------------------
RewriteRule ^self-learning/?$ /self-learning/index.html [L,QSA]
RewriteRule ^self-learning/sub-categories/([^/]+)/?$ /self-learning/sub-categories/$1/index.html [L,QSA]
RewriteRule ^self-learning/selection/([^/]+)/?$ /self-learning/selection/$1/index.html [L,QSA]
RewriteRule ^self-learning/self-learning-play/?$ /self-learning/self-learning-play/index.html [L,QSA]
RewriteRule ^self-learning/result/?$ /self-learning/result/index.html [L,QSA]
RewriteRule ^self-learning/review-answer/?$ /self-learning/review-answer/index.html [L,QSA]

# ------------------------------
# CONTEST PLAY
# ------------------------------
RewriteRule ^contest-play/?$ /contest-play/index.html [L,QSA]
RewriteRule ^contest-play/contest-leaderboard/?$ /contest-play/contest-leaderboard/index.html [L,QSA]
RewriteRule ^contest-play/contest-play-board/?$ /contest-play/contest-play-board/index.html [L,QSA]
RewriteRule ^contest-play/result/?$ /contest-play/result/index.html [L,QSA]
RewriteRule ^contest-play/review-answer/?$ /contest-play/review-answer/index.html [L,QSA]

# ------------------------------
# RANDOM BATTLE
# ------------------------------
RewriteRule ^random-battle/?$ /random-battle/index.html [L,QSA]
RewriteRule ^random-battle/play-with-friend-battle/?$ /random-battle/play-with-friend-battle/index.html [L,QSA]
RewriteRule ^random-battle/play-with-friend-play/?$ /random-battle/play-with-friend-play/index.html [L,QSA]
RewriteRule ^random-battle/random-play/?$ /random-battle/random-play/index.html [L,QSA]
RewriteRule ^random-battle/result/?$ /random-battle/result/index.html [L,QSA]
RewriteRule ^random-battle/review-answer/?$ /random-battle/review-answer/index.html [L,QSA]

# ------------------------------
# GROUP BATTLE
# ------------------------------
RewriteRule ^group-battle/?$ /group-battle/index.html [L,QSA]
RewriteRule ^group-battle/group-play/?$ /group-battle/group-play/index.html [L,QSA]
RewriteRule ^group-battle/result/?$ /group-battle/result/index.html [L,QSA]

# ------------------------------
# AUDIO QUESTIONS
# ------------------------------
RewriteRule ^audio-questions/?$ /audio-questions/index.html [L,QSA]
RewriteRule ^audio-questions/audio-questions-play/?$ /audio-questions/audio-questions-play/index.html [L,QSA]
RewriteRule ^audio-questions/sub-categories/([^/]+)/?$ /audio-questions/sub-categories/$1/index.html [L,QSA]
RewriteRule ^audio-questions/result/?$ /audio-questions/result/index.html [L,QSA]
RewriteRule ^audio-questions/review-answer/?$ /audio-questions/review-answer/index.html [L,QSA]

# ------------------------------
# MATH MANIA
# ------------------------------
RewriteRule ^math-mania/?$ /math-mania/index.html [L,QSA]
RewriteRule ^math-mania/math-mania-play/?$ /math-mania/math-mania-play/index.html [L,QSA]
RewriteRule ^math-mania/sub-categories/([^/]+)/?$ /math-mania/sub-categories/$1/index.html [L,QSA]
RewriteRule ^math-mania/result/?$ /math-mania/result/index.html [L,QSA]
RewriteRule ^math-mania/review-answer/?$ /math-mania/review-answer/index.html [L,QSA]

# ------------------------------
# MULTI MATCH
# ------------------------------
RewriteRule ^multi-match-questions/?$ /multi-match-questions/index.html [L,QSA]
RewriteRule ^multi-match-questions/sub-categories/([^/]+)/?$ /multi-match-questions/sub-categories/$1/index.html [L,QSA]
RewriteRule ^multi-match-questions/level/([^/]+)/?$ /multi-match-questions/level/$1/index.html [L,QSA]
RewriteRule ^multi-match-questions/level/([^/]+)/dashboard-play/?$ /multi-match-questions/level/$1/dashboard-play/index.html [L,QSA]
RewriteRule ^multi-match-questions/result/?$ /multi-match-questions/result/index.html [L,QSA]
RewriteRule ^multi-match-questions/review-answer/?$ /multi-match-questions/review-answer/index.html [L,QSA]

# ------------------------------
# PROMPT HEROES
# ------------------------------
RewriteRule ^prompt-heroes/?$ /prompt-heroes/index.html [L,QSA]

# ------------------------------
# TRENDING - STATIC FIRST, DYNAMIC FALLBACK
# ------------------------------
RewriteRule ^trending/?$ /trending/index.html [L,QSA]

# Check if static HTML exists for this specific slug
RewriteCond %{DOCUMENT_ROOT}/trending/prompt/$1/index.html -f
RewriteRule ^trending/prompt/([^/]+)/?$ /trending/prompt/$1/index.html [L,QSA]

# If static doesn't exist, serve the dynamic [promptDetail] template
RewriteRule ^trending/prompt/([^/]+)/?$ /trending/prompt/\[promptDetail\]/index.html [L,QSA]

# ------------------------------
# OTHER STATIC PAGES
# ------------------------------
RewriteRule ^auth/login/?$ /auth/login/index.html [L,QSA]
RewriteRule ^auth/otp-verify/?$ /auth/otp-verify/index.html [L,QSA]
RewriteRule ^auth/reset-password/?$ /auth/reset-password/index.html [L,QSA]
RewriteRule ^auth/sign-up/?$ /auth/sign-up/index.html [L,QSA]

RewriteRule ^privacy-policy/?$ /privacy-policy/index.html [L,QSA]
RewriteRule ^contact-us/?$ /contact-us/index.html [L,QSA]
RewriteRule ^about-us/?$ /about-us/index.html [L,QSA]
RewriteRule ^instruction/?$ /instruction/index.html [L,QSA]
RewriteRule ^terms-conditions/?$ /terms-conditions/index.html [L,QSA]

RewriteRule ^profile/?$ /profile/index.html [L,QSA]
RewriteRule ^profile/badges/?$ /profile/badges/index.html [L,QSA]
RewriteRule ^profile/bookmark/?$ /profile/bookmark/index.html [L,QSA]
RewriteRule ^profile/coin-history/?$ /profile/coin-history/index.html [L,QSA]
RewriteRule ^profile/invite-friends/?$ /profile/invite-friends/index.html [L,QSA]
RewriteRule ^profile/statistics/?$ /profile/statistics/index.html [L,QSA]
RewriteRule ^profile/wallet/?$ /profile/wallet/index.html [L,QSA]
RewriteRule ^profile/leaderboard/?$ /profile/leaderboard/index.html [L,QSA]

# ------------------------------
# EXTRA ROUTES
# ------------------------------
RewriteRule ^maintenance/?$ /maintenance/index.html [L,QSA]
RewriteRule ^loading/?$ /loading/index.html [L,QSA]
RewriteRule ^home/?$ /home/index.html [L,QSA]
RewriteRule ^quiz-play/?$ /quiz-play/index.html [L,QSA]
RewriteRule ^play-bookmark-questions/?$ /play-bookmark-questions/index.html [L,QSA]
RewriteRule ^notifications/?$ /notifications/index.html [L,QSA]

# Daily Quiz
RewriteRule ^quiz-play/daily-quiz-dashboard/?$ /quiz-play/daily-quiz-dashboard/index.html [L,QSA]
RewriteRule ^quiz-play/daily-quiz-dashboard/result/?$ /quiz-play/daily-quiz-dashboard/result/index.html [L,QSA]
RewriteRule ^quiz-play/daily-quiz-dashboard/review-answer/?$ /quiz-play/daily-quiz-dashboard/review-answer/index.html [L,QSA]

# True/False Quiz
RewriteRule ^quiz-play/true-and-false-play/?$ /quiz-play/true-and-false-play/index.html [L,QSA]
RewriteRule ^quiz-play/true-and-false-play/result/?$ /quiz-play/true-and-false-play/result/index.html [L,QSA]
RewriteRule ^quiz-play/true-and-false-play/review-answer/?$ /quiz-play/true-and-false-play/review-answer/index.html [L,QSA]

# ------------------------------
# ERROR HANDLING
# ------------------------------
ErrorDocument 404 /404/index.html

</IfModule>